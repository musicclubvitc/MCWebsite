  "faqs": [
    {
      "q": "When are auditions held for freshers?",
      "a": "Club auditions are conducted every academic year right after the Fresher's Talent Hunt. Circulars and audition dates are posted on our Instagram @vitcmusicclub."
    },
    {
      "q": "Can non-members book the music room?",
      "a": "The music room is reserved for verified club members and registered bands. During Open Mic weeks, slots may open to other students with prior registration."
    },
    {
      "q": "How do I register a new band?",
      "a": "Sign in to the Member Portal, navigate to 'My Bands', and submit the registration form with between 3 and 9 members."
    },
    {
      "q": "What instruments does the club provide?",
      "a": "The club maintains Fender Stratocaster electric guitars, Yamaha acoustic guitars, Ibanez 5-string bass, Roland XPS-30 synthesizers, Pearl drumkits, and Shure vocal microphones."
    }
  ],
